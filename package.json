{
  "name": "cryomap",
  "version": "0.1.0",
  "private": true,
  "description": "Collaborative wiring-diagram editor for quantum-computing dilution refrigerators.",
  "license": "Apache-2.0",
  "author": "Raj Shah",
  "homepage": "https://cryomap.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rajshahbuilds/cryomap.git"
  },
  "bugs": {
    "url": "https://github.com/rajshahbuilds/cryomap/issues"
  },
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test -c playwright.smoke.config.ts",
    "test:rls": "bash supabase/tests/run.sh"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "jspdf": "^4.2.1",
